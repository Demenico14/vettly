# Copy to .env for docker compose. Development values only; never reuse them in production.

# Public address of the app, used in links in emails.
APP_URL=http://localhost:3000
# Secret for signing candidate access cookies. Use a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated emails of Vettly platform administrators.
VETTLY_SUPER_ADMINS=

# PostgreSQL (docker compose service "db")
POSTGRES_USER=vettly
POSTGRES_PASSWORD=vettly-dev-password
POSTGRES_DB=vettly
# The owner runs migrations and platform administration; it bypasses row-level security.
MIGRATION_DATABASE_URL=postgres://vettly:vettly-dev-password@db:5432/vettly
# The app runs as this user. Vettly creates it on start-up with data access only, so row-level security applies.
DATABASE_URL=postgres://vettly_app:vettly-app-dev-password@db:5432/vettly

# S3-compatible document storage (docker compose service "storage", SeaweedFS)
S3_ENDPOINT=http://storage:8333
S3_REGION=af-south-1
S3_BUCKET=vettly-documents
S3_ACCESS_KEY=vettly
S3_SECRET_KEY=vettly-dev-secret

# Outgoing email (docker compose service "mail"; Mailpit catches everything, inbox at http://localhost:8025)
SMTP_HOST=mail
SMTP_PORT=1025
EMAIL_FROM="Vettly <no-reply@vettly.local>"
