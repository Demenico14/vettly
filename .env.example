# Copy to .env for docker compose. Development values only; never reuse them in production.

# Which implementation each service uses: "mock" (in-memory, today) or "real" (backend, as phases land).
VETTLY_SERVICES=mock

# PostgreSQL (docker compose service "db")
POSTGRES_USER=vettly
POSTGRES_PASSWORD=vettly-dev-password
POSTGRES_DB=vettly
DATABASE_URL=postgres://vettly:vettly-dev-password@db:5432/vettly

# S3-compatible document storage (docker compose service "storage", SeaweedFS)
S3_ENDPOINT=http://storage:8333
S3_REGION=af-south-1
S3_BUCKET=vettly-documents
S3_ACCESS_KEY=vettly
S3_SECRET_KEY=vettly-dev-secret

# Outgoing email (docker compose service "mail"; Mailpit catches everything, inbox at http://localhost:8025)
SMTP_HOST=mail
SMTP_PORT=1025
EMAIL_FROM="Vettly <no-reply@vettly.local>"
